{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "INNGEST_DEV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".output/**",
        ".vercel/output/**"
      ],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_DEV",
        "NITRO_PRESET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_DEV"
      ]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "lint:fix": {},
    "format": {},
    "format:check": {},
    "db:generate": {},
    "db:migrate": {},
    "db:push": {},
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CONTROL_PLANE_TEST_DATABASE_URL"]
    }
  }
}
