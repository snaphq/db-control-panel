# Local development defaults for this site (non-secret; committed).
# Shared secrets live in the repo-root .env.local, symlinked into this folder.

# Vite exposes env to the client only through the VITE_ prefix.
VITE_APP_URL=http://localhost:8803
VITE_PUBLIC_APP_URL=http://localhost:8803

# Server-side only. The Next.js sites pin this through next.config.ts `env`;
# SolidStart has no equivalent, so it is read from the environment directly.
BETTER_AUTH_URL=http://localhost:8803
APP_URL=http://localhost:8803

# Pins the tenant that local (localhost) requests resolve to. Production
# requests resolve their tenant from the Host header via tenant_domain.
# getLocalTenantId() in @repo/database reads this; without it a local request
# falls back to DEFAULT_TENANT_ID and this site would collide with com.site-a.
SITE_TENANT_ID=site-c
