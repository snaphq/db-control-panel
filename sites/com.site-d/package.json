{
  "name": "com.site-d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Astro tenant site. Shares the monorepo DATABASE_URL; owns its own tenant identity and does not use @repo/site-kit.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 8804",
    "build": "astro build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "catalog:",
    "@astrojs/vercel": "catalog:",
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/database": "workspace:*",
    "astro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "^0.44.7",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
