---
import BaseLayout from "../layouts/BaseLayout.astro";

const tiers = [
  {
    name: "Starter",
    price: "$0",
    period: "forever",
    features: ["1 workspace", "Community support", "Core analytics"],
    featured: false,
  },
  {
    name: "Growth",
    price: "$29",
    period: "per month",
    features: [
      "Unlimited workspaces",
      "Priority support",
      "Advanced analytics",
    ],
    featured: true,
  },
  {
    name: "Scale",
    price: "$99",
    period: "per month",
    features: [
      "Everything in Growth",
      "SSO and audit logs",
      "Dedicated support",
    ],
    featured: false,
  },
];
---

<BaseLayout description="Simple pricing for every stage." title="Pricing">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-center text-3xl font-semibold tracking-tight">Pricing</h1>
    <p class="mt-3 text-center text-zinc-600">
      Start free, upgrade when the workspace grows.
    </p>
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {tiers.map((tier) => (
        <div
          class:list={[
            "rounded-xl border p-6",
            tier.featured
              ? "border-zinc-900 shadow-lg"
              : "border-zinc-200",
          ]}
        >
          <h2 class="font-medium">{tier.name}</h2>
          <p class="mt-3 text-3xl font-semibold tracking-tight">
            {tier.price}
            <span class="text-sm font-normal text-zinc-500">
              {" "}
              {tier.period}
            </span>
          </p>
          <ul class="mt-6 space-y-2 text-sm text-zinc-600">
            {tier.features.map((feature) => (
              <li class="flex gap-2">
                <span aria-hidden="true">·</span>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
