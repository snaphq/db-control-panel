---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout description="Privacy policy." title="Privacy Policy">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Privacy Policy</h1>
    <div class="mt-6 space-y-4 text-zinc-600">
      <p>
        This site stores only the information needed to operate your account:
        your name, email address, and the sessions you create.
      </p>
      <p>
        We do not sell personal information, and we do not share it with third
        parties beyond the processors required to run the service.
      </p>
      <p>
        To request deletion of your account and its data, contact the site
        operator.
      </p>
    </div>
  </section>
</BaseLayout>
