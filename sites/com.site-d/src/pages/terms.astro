---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout description="Terms and conditions." title="Terms">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Terms</h1>
    <div class="mt-6 space-y-4 text-zinc-600">
      <p>
        By creating an account you agree to use the service lawfully and to keep
        your credentials secure.
      </p>
      <p>
        The service is provided as-is. Availability, features, and pricing may
        change with notice.
      </p>
    </div>
  </section>
</BaseLayout>
