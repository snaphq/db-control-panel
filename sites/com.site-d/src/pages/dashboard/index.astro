---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getAccountOverview } from "../../server/account";
import { getSessionFromRequest } from "../../server/session";

const session = await getSessionFromRequest(Astro.request);
if (!session) return Astro.redirect("/dashboard/login");

const tenant = Astro.locals.tenant;
const { account, organizations, sessions } = await getAccountOverview(
  tenant.id,
  session.user.id,
);

const formatDate = (date: Date | null | undefined) =>
  date ? date.toISOString().slice(0, 10) : "—";
---

<DashboardLayout title={`Dashboard · ${tenant.name}`} userName={session.user.email}>
  <h1 class="text-2xl font-semibold tracking-tight">
    Welcome back{account?.name ? `, ${account.name}` : ""}
  </h1>
  <p class="mt-1 text-sm text-zinc-600">
    Your account on {tenant.name}.
  </p>

  <section class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-zinc-200 p-5">
      <p class="text-xs tracking-wide text-zinc-400 uppercase">Email</p>
      <p class="mt-1 truncate text-sm font-medium">{account?.email ?? session.user.email}</p>
    </div>
    <div class="rounded-xl border border-zinc-200 p-5">
      <p class="text-xs tracking-wide text-zinc-400 uppercase">Role</p>
      <p class="mt-1 text-sm font-medium">{account?.role ?? "member"}</p>
    </div>
    <div class="rounded-xl border border-zinc-200 p-5">
      <p class="text-xs tracking-wide text-zinc-400 uppercase">Member since</p>
      <p class="mt-1 text-sm font-medium">{formatDate(account?.createdAt)}</p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-medium">Organizations</h2>
    {organizations.length === 0 ? (
      <p class="mt-3 rounded-xl border border-dashed border-zinc-300 p-6 text-sm text-zinc-500">
        You are not a member of any organization yet.
      </p>
    ) : (
      <ul class="mt-3 divide-y divide-zinc-200 rounded-xl border border-zinc-200">
        {organizations.map((org) => (
          <li class="flex items-center justify-between gap-4 px-5 py-3 text-sm">
            <span class="font-medium">{org.name}</span>
            <span class="text-zinc-500">
              {org.role} · {org.status}
            </span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-medium">Active sessions</h2>
    {sessions.length === 0 ? (
      <p class="mt-3 rounded-xl border border-dashed border-zinc-300 p-6 text-sm text-zinc-500">
        No other sessions.
      </p>
    ) : (
      <ul class="mt-3 divide-y divide-zinc-200 rounded-xl border border-zinc-200">
        {sessions.map((entry) => (
          <li class="flex items-center justify-between gap-4 px-5 py-3 text-sm">
            <span class="truncate">
              {entry.ipAddress ?? "unknown address"} ·{" "}
              {entry.userAgent ?? "unknown client"}
            </span>
            <span class="shrink-0 text-zinc-500">
              expires {formatDate(entry.expiresAt)}
            </span>
          </li>
        ))}
      </ul>
    )}
  </section>
</DashboardLayout>
