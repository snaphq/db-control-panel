---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout description="Page not found." title="Not found">
  <section class="mx-auto max-w-5xl px-4 py-24 text-center">
    <p class="text-sm font-medium text-zinc-500">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 text-zinc-600">The page you asked for does not exist.</p>
    <a
      class="mt-8 inline-block rounded-lg bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-zinc-700"
      href="/">Back to the homepage</a
    >
  </section>
</BaseLayout>
