{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".agents/skills/*/scripts/**/*.ts",
        "scripts/*.{ts,mjs,js}",
        "infra/scripts/*.ts"
      ],
      "project": [
        ".agents/skills/*/scripts/**/*.ts",
        "scripts/**/*.{ts,mjs,js}",
        "infra/scripts/**/*.ts"
      ]
    },
    "apps/*": {},
    "packages/*": {},
    "sites/*": {
      "entry": [
        "src/site.config.ts",
        "src/lib/source.ts",
        "src/components/Container/PageWrapper.tsx"
      ]
    }
  },
  "ignore": [
    "docs-public/**",
    "docs-internal/**",
    ".agents/tasks/**",
    "sites/*/src/.source/**"
  ]
}
