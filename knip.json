{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".agents/skills/*/scripts/**/*.ts", "scripts/*.{ts,mjs,js}"],
      "project": [
        ".agents/skills/*/scripts/**/*.ts",
        "scripts/**/*.{ts,mjs,js}"
      ]
    },
    "apps/*": {},
    "packages/*": {},
    "sites/*": {
      "entry": [
        "src/site.config.ts",
        "src/lib/source.ts",
        "src/components/Container/PageWrapper.tsx"
      ]
    },
    "sites/com.site-c": {
      "entry": [
        "vite.config.ts",
        "src/entry-client.tsx",
        "src/entry-server.tsx",
        "src/app.tsx",
        "src/site.config.ts",
        "src/routes/**/*.{ts,tsx}",
        "src/http/*.ts"
      ]
    }
  },
  "ignore": [
    "docs-public/**",
    "docs-internal/**",
    ".agents/tasks/**",
    "sites/*/src/.source/**"
  ]
}
