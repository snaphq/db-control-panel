{
  "name": "nextjs-starter-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "catalog": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fumadocs-mdx": "^14.2.11",
    "google-auth-library": "^10.6.2",
    "inngest": "^4.2.4",
    "mcp-handler": "^1.0.3",
    "nanoid": "^5.0.7",
    "next": "16.3.5",
    "posthog-node": "^5.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "7.0.2",
    "undici": "^6.25.0",
    "vitest": "^3.2.1",
    "zod": "^3.23.5"
  },
  "scripts": {
    "dev": "bun run .setup/dev-guard.ts",
    "dev:all": "turbo run dev",
    "dev:ws": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:query": "bun run --filter @repo/database db:query --",
    "db:studio": "bun run --filter @repo/database db:studio",
    "db:seed": "bun run scripts/seed-admin.ts",
    "db:seed:billing": "bun run scripts/seed-billing.ts",
    "seed:integrations": "bun run scripts/seed-integrations.ts",
    "seed:seo:engines": "bun run scripts/seed-seo-engines.ts",
    "seed:seo:settings": "bun run scripts/seed-seo-settings.ts",
    "seed:seo:prompts": "bun run scripts/seed-seo-prompts.ts",
    "setup:stripe": "bun run .setup/setup-stripe.ts",
    "setup:posthog": "bun run .setup/setup-posthog.ts",
    "setup:referral": "bun run .setup/setup-referral.ts",
    "stripe:verify": "node scripts/verify-stripe-keys.js",
    "stripe:migrate": "bun run scripts/migrate-stripe-schema.ts",
    "stripe:backfill": "bun run scripts/backfill-stripe-data.ts",
    "posthog:test-event": "bun run scripts/test-posthog-event.ts",
    "posthog:test-workflow": "bun run scripts/test-posthog-workflow.ts",
    "check:max-lines": "bun run scripts/check-max-lines.ts",
    "check:staged-types": "bun run scripts/check-staged-types.ts",
    "check:no-middleware": "bun run scripts/check-no-middleware.ts",
    "check:banned-deps": "bun run scripts/check-banned-deps.ts",
    "check:root-md": "bun run scripts/check-root-md.ts",
    "check:doc-paths": "bun run scripts/check-doc-paths.ts",
    "check:doc-coverage": "bun run scripts/check-doc-coverage.ts",
    "check:catalog-deps": "bun run scripts/check-catalog-deps.ts",
    "check:no-per-minute-cron": "bun run scripts/check-no-per-minute-cron.ts",
    "check:dead-code": "bun run scripts/check-dead-code.ts",
    "check:skill-links": "bun run scripts/check-skill-links.ts",
    "docs:public": "cd docs-public && bunx --yes mint@4.1.0 dev --port 3333 --no-open",
    "docs:public:validate": "cd docs-public && bunx --yes mint@4.1.0 broken-links",
    "docs:internal": "cd docs-internal && bunx --yes mint@4.1.0 dev --port 3334 --no-open",
    "docs:internal:validate": "cd docs-internal && bunx --yes mint@4.1.0 broken-links",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@inquirer/prompts": "^8.5.2",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "fallow": "3.14.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^15.5.2",
    "posthog-node": "catalog:",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0"
  }
}
