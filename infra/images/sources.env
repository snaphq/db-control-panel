# Pinned sources for every AlloyDB image. Images are built only from these
# snaphq mirrors at these exact commits; bump a ref here to rebuild.
# Read by .github/workflows/images.yml (sourced as shell variables).

# Neon storage + compute (storage_broker, storage_controller, pageserver,
# safekeeper, proxy, compute_ctl). Its Postgres submodules resolve to
# snaphq/postgres through the relative URL ../postgres.git.
NEON_REPO=snaphq/neon
NEON_REF=fa504217c61bbcaf5c512d75830564541f917f8f

# Postgres major version for compute images (Neon vendor/postgres-v17, 17.5).
PG_VERSION=v17

# libSQL server (sqld + bottomless-cli), tag libsql-server-v0.24.33.
LIBSQL_REPO=snaphq/libsql
LIBSQL_REF=40a151bdb2b8c78109e90e8d92f0dba9b47d38e3

# PostgREST for the REST Data API, tag v16.4.
POSTGREST_REPO=snaphq/postgrest
POSTGREST_REF=0d97c05d8d23bd8a83c867abc45ef481a6d5d2c7
