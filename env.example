# ============================================
# REQUIRED - Database
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alloydb

# ============================================
# Application URLs are per app, not in this shared file:
#   apps/backend/.env.development      NEXT_PUBLIC_APP_URL (port 8800)
#   sites/<site>/.env.development      NEXT_PUBLIC_APP_URL (also the auth base URL)
# In production set them in each app's Vercel project.
# ============================================

# ============================================
# REQUIRED - Better Auth (tenant sites)
# Generate secret with: openssl rand -base64 32
# ============================================
BETTER_AUTH_SECRET=your-secret-key-here

# ============================================
# REQUIRED - Backend admin portal (apps/backend)
# Comma-separated emails allowed to sign in to the admin portal with an
# emailed one-time code. Removing an email revokes access immediately.
# Generate the secret with: openssl rand -base64 32
# ============================================
BACKEND_ADMIN_EMAILS=
BACKEND_SESSION_SECRET=

# ============================================
# Default tenant (seeded by `bun run db:seed`)
# Each site's tenant id, name, and domain come from sites/*/src/site.config.ts
# (`bun run db:seed:sites`); DEFAULT_TENANT_ID must match the primary site's.
# ============================================
DEFAULT_TENANT_ID=default
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default Platform
DEFAULT_TENANT_PLATFORM_NAME=Default Platform
DEFAULT_TENANT_DOMAIN=
DEFAULT_TENANT_SUPPORT_EMAIL=
DEFAULT_TENANT_LOGO_URL=
DEFAULT_TENANT_FAVICON_URL=

# ============================================
# OPTIONAL - Stripe Payments
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (client-side) — required for inline card collection in
# the "Create Workspace" flow.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================
# OPTIONAL - Upstash Redis (Rate Limiting & Caching)
# Get credentials from: https://upstash.com
# ============================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# OPTIONAL - Axiom (structured MCP/operator activity logs)
# When unset, operator activity falls back to the operator_activity table.
# AXIOM_OPERATOR_DATASET is optional and defaults to AXIOM_DATASET.
# ============================================
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_OPERATOR_DATASET=

# ============================================
# OPTIONAL - Email Provider (zsend)
# Optional. Without it, admin sign-in codes are written to the server log, and
# password reset emails print to the console in development but are not sent
# (or logged) in production.
# Get an API key from https://zsend.dev; the from domain must be verified there.
# ============================================
ZSEND_API_KEY=
ZSEND_FROM_EMAIL=noreply@yourdomain.com
ZSEND_FROM_NAME=AlloyDB
# Only for a self-hosted zsend instance; defaults to https://zsend.dev/api/v1
ZSEND_BASE_URL=

# ============================================
# OPTIONAL - Admin Configuration
# ============================================

# Auto-promote users from these email domains to site-admin role
# Comma-separated list (e.g., mycompany.com,team.io)
ADMIN_EMAIL_DOMAINS=

# Initial admin user credentials (created via 'bun run db:seed')
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================================
# OPTIONAL - Integrations
# ============================================

# AES-256-GCM key for encrypting integration credentials.
# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Production egress allowlist for installed MCP servers (comma-separated
# hostnames or wildcard suffixes). Leave unset only for local development.
MCP_PROXY_ALLOWED_HOSTS=

# Production egress allowlist for custom OpenAI-compatible providers. The
# canonical api.openai.com host is allowed by default; add custom provider
# hostnames here before using them in production. Provider URLs cannot include
# credentials, query strings, fragments, or private-network addresses.
AI_PROVIDER_ALLOWED_HOSTS=

# ============================================
# OPTIONAL - Agent authentication
# ============================================

# Set false only when intentionally disabling the agent registration/token
# surface. Production otherwise requires a durable ES256 private key.
AGENT_AUTH_ENABLED=true
# Generate with: openssl ecparam -name prime256v1 -genkey -noout -out agent-auth.pem
# Store the PEM as a single environment value (escaped newlines are accepted).
AGENT_AUTH_PRIVATE_KEY=
AGENT_AUTH_KEY_ID=agent-auth-1
AGENT_AUTH_ASSERTION_TTL_DAYS=30
AGENT_AUTH_ACCESS_TOKEN_TTL=3600
AGENT_AUTH_REGISTRATION_TTL_DAYS=30
ID_JAG_MAX_AUTH_AGE_SECONDS=3600
# Set false only for local development; production always requires auth.
MCP_REQUIRE_AUTH=true

# ============================================
# OPTIONAL - Object storage
# Set OBJECT_STORAGE_PROVIDER to vercel-blob or s3; leave empty to disable.
# ============================================
OBJECT_STORAGE_PROVIDER=
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============================================
# OPTIONAL - Passkey (WebAuthn)
# ============================================

# Relying-Party ID for passkey registration/authentication.
# Defaults to "localhost" when unset. In production set to the apex domain
# users sign in from (e.g. example.com or app.example.com). Must match the
# eTLD+1 of NEXT_PUBLIC_APP_URL.
PASSKEY_RP_ID=

# ============================================
# OPTIONAL - OAuth Providers
# ============================================

# Google sign-in. The public client id is used to gate the "Continue with
# Google" button on the sign-in page; both must be set to enable Google auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in. Both must be set to enable the GitHub provider.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Inngest — local dev uses the inngest CLI; production requires signing keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set INNGEST_DEV=1 and point BASE_URL to the local CLI when running locally.
# Leave both unset (or empty) in production.
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288

# @repo/ai — OpenAI-compatible gateway settings (used by packages/ai).
# OPENAI_BASE_URL may point to an approved HTTPS-compatible endpoint. In
# production its hostname must be listed in AI_PROVIDER_ALLOWED_HOSTS (the
# canonical api.openai.com host is allowed by default).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini

# ============================================
# OPTIONAL - AlloyDB platform infra (infra/scripts/render-secrets.ts)
# Turned into Kubernetes Secrets with:
#   bun infra/scripts/render-secrets.ts | kubectl apply -f -
# S3 holds Neon pageserver/ and safekeeper/ data, libSQL (sqld) bottomless
# backups, and platform-backups/ dumps. Never commit real values.
# ============================================
ALLOYDB_S3_ENDPOINT=
ALLOYDB_S3_REGION=
ALLOYDB_S3_BUCKET=
ALLOYDB_S3_ACCESS_KEY_ID=
ALLOYDB_S3_SECRET_ACCESS_KEY=
# Optional dedicated bucket for sqld; sqld cannot use a key prefix. Defaults to
# ALLOYDB_S3_BUCKET (objects then start with ns-sqld:).
ALLOYDB_SQLD_S3_BUCKET=
# Cloudflare API token (Zone:DNS:Edit, Zone:Zone:Read) for cert-manager DNS-01.
ALLOYDB_CLOUDFLARE_API_TOKEN=
# Let's Encrypt account email (Flux substitutes it as ${ACME_EMAIL}).
ALLOYDB_ACME_EMAIL=
# Platform Postgres superuser password. Generate with: openssl rand -hex 24
ALLOYDB_PLATFORM_POSTGRES_PASSWORD=
# sqld admin API key. Generate with: openssl rand -hex 32
ALLOYDB_LIBSQL_ADMIN_KEY=
# Token the Neon proxy sends to the control plane. Generate with: openssl rand -hex 32
ALLOYDB_NEON_PROXY_TOKEN=
# Token the console's server code sends to the control-plane API (api.alloydb.net).
# Set the same value in the console's Vercel env. Generate with: openssl rand -hex 32
ALLOYDB_API_TOKEN=
# Token the platform admin portal sends to the control plane's /v1/admin/* routes.
# Must differ from ALLOYDB_API_TOKEN (the console token is refused there and this one
# is refused on the console routes). Set it in the alloydb-admin Vercel project ONLY,
# never in the console's. Generate with: openssl rand -hex 32
ALLOYDB_ADMIN_API_TOKEN=
# Base URL the console's server code calls for the Databases tab (packages/core
# control-plane client). Optional; defaults to https://api.alloydb.net.
# Without ALLOYDB_API_TOKEN the Databases tab reports that databases are not set up.
ALLOYDB_API_URL=
# AES-256 key (32 random bytes, base64) that seals the credentials the control plane
# must read back: role passwords and the Data API signing key. Rotating it makes
# every stored value unreadable, so keep a copy. Generate with: openssl rand -base64 32
ALLOYDB_DATA_KEY=
# Ed25519 signing keys, base64 of the PKCS#8 PEM. Leave empty and run
# render-secrets.ts once with --generate-neon-keys / --generate-libsql-keys, then
# paste the printed line here (a new key invalidates every issued token).
ALLOYDB_NEON_JWT_PRIVATE_KEY=
ALLOYDB_LIBSQL_JWT_PRIVATE_KEY=
# Node bootstrap (infra/ansible). k3s cluster join token: openssl rand -hex 32
ALLOYDB_K3S_TOKEN=
# Tailscale auth key (reusable or one-off) used by `tailscale up` on new nodes.
ALLOYDB_TAILSCALE_AUTHKEY=
# Cloudflare zone for the public DNS records (defaults to alloydb.net).
ALLOYDB_CLOUDFLARE_ZONE=
